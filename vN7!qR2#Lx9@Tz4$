	local gv = 1
	if gt:FindFirstChild("ultimatesFolder") and gt.ultimatesFolder:FindFirstChild("Infernal Health") then
		gv += 0.15 * (gt.ultimatesFolder["Infernal Health"].Value or 0)
	end
