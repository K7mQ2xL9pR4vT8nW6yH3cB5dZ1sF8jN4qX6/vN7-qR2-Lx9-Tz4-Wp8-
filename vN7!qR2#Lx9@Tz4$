local function af(ag)
	ag = math.max(0, math.floor(ag))
	local ah = math.floor(ag / 86400)
	local ai = math.floor((ag % 86400) / 3600)
	local aj = math.floor((ag % 3600) / 60)
	local ak = ag % 60
	return string.format("%dD / %dH / %dM / %dS", ah, ai, aj, ak)
end

local function al(am)
	if am >= 1e15 then
		return string.format("%.1fqa", am / 1e15)
	elseif am >= 1e12 then
		return string.format("%.1ft", am / 1e12)
	elseif am >= 1e9 then
		return string.format("%.1fb", am / 1e9)
	elseif am >= 1e6 then
		return string.format("%.1fm", am / 1e6)
	elseif am >= 1e3 then
		return string.format("%.1fk", am / 1e3)
	elseif am == math.floor(am) then
		return tostring(math.floor(am))
	else
		return string.format("%.1f", am)
	end
end

local function an(ao)
	local ap = tostring(math.floor(ao))
	local aq
	while true do
		ap, aq = ap:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if aq == 0 then break end
	end
	return ap
end

local function kz(la)
	local lb = la < 0
	la = math.abs(la)
	local lc = {
		{1e18, "Qi"},
		{1e15, "Qa"},
		{1e12, "T"},
		{1e9, "B"},
		{1e6, "M"}
	}
	for _, ld in ipairs(lc) do
		local le, lf = ld[1], ld[2]
		if la >= le then
			local lg = la / le
			if lf == "Qi" or lf == "Qa" then
				return (lb and "-" or "") .. string.format("%.2f%s", lg, lf)
			else
				return (lb and "-" or "") .. string.format("%.1f%s", lg, lf)
			end
		end
	end
	return (lb and "-" or "") .. string.format("%.0f", la)
end

