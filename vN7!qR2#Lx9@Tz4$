local function antiLag()
	local plr = i
	if not plr then return end
	local gui = plr:FindFirstChildOfClass("PlayerGui") or plr:WaitForChild("PlayerGui", 5)
	local char = plr.Character
	local cam = l.CurrentCamera
	local function keep(obj)
		if not obj then return true end
		if obj == plr or obj == cam or obj == gui then return true end
		if char and (obj == char or obj:IsDescendantOf(char)) then return true end
		if gui and obj:IsDescendantOf(gui) then return true end
		return false
	end
	local function clean(obj)
		if obj and not keep(obj) then
			pcall(function() obj:Destroy() end)
		end
	end
	for _, v in ipairs(k:GetDescendants()) do clean(v) end
	pcall(function()
		k.GlobalShadows = false
		k.FogStart = 9e9
		k.FogEnd = 9e9
		k.Brightness = 0
		k.EnvironmentDiffuseScale = 0
		k.EnvironmentSpecularScale = 0
